# Environment Variables for Indian Law AI Portal

# LLM provider: "groq" (recommended, fast + free tier) or "gemini"
LLM_PROVIDER=groq

# Groq Configuration (used when LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Cheap Groq models (128k ctx). Default: openai/gpt-oss-20b (a reasoning model,
# best legal accuracy per rupee; GroqLLMClient auto-sets reasoning_effort=low).
# Alternative: llama-3.1-8b-instant (fastest/cheapest, but weaker on legal nuance).
# Avoid 70B/120B, they are costly.

# Google AI Configuration (used when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_PROJECT_ID=your_project_id
LLM_MODEL=gemini-2.0-flash

# Embeddings — local sentence-transformers model (384-dim, no API quota).
# Do NOT use gemini-embedding-001 on the free tier: it rate-limits during
# ingestion and poisons the index.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector Database Configuration
VECTOR_DB_TYPE=faiss
VECTOR_DB_PATH=./vector_db/

# RAG Configuration
RAG_FUSION_QUERIES=3
TOP_K_RETRIEVAL=10
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval quality (BM25 hybrid is always on; cross-encoder rerank is optional)
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_CANDIDATES=24
CITED_SOURCES_K=8

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
# DEBUG_MODE=false is the deployment switch: it turns OFF auto-reload, /docs,
# exception details in error responses, and (unless ADMIN_API_KEY is set) all
# sensitive /admin endpoints. Keep true only for local development.
DEBUG_MODE=true

# Admin key — required to call sensitive /admin endpoints (documents/process,
# database/clear, database/save, system/reinitialize, statistics) on a deployed
# instance (send it as the X-Admin-Key header). Leave empty locally: with
# DEBUG_MODE=true admin works without a key; with DEBUG_MODE=false and no key,
# admin endpoints are disabled entirely (safest deployment default).
ADMIN_API_KEY=

# Daily rate limit — GLOBAL cap on total LLM answers per day (UTC midnight reset),
# so an unpaid Groq budget can't be blown by traffic. Once reached, every request
# gets a 429 and the frontend shows the "daily limit" modal. Set to 0 to block all
# calls; raise RATE_LIMIT_ENABLED=false to disable the cap entirely.
RATE_LIMIT_ENABLED=true
DAILY_QUERY_LIMIT=25

# CORS — comma-separated origins allowed to call the API. Add your deployed
# frontend origin here when you deploy (keep localhost for local dev).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Assets
ASSETS_PATH=./assets/
